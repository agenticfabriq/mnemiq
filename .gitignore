# Secrets / env — never commit
.env
.env.*
!.env.example

# Data / build artifacts
*.duckdb
*.duckdb.wal
eval-reports/

# Benchmark Parquet exports written by bird_to_parquet.py -- ~700 MB of derived data
# regenerable from the source SQLite in one command. `/out/` was in this file and was lost
# in a merge; it is restored with its siblings because an unignored 400 MB directory is one
# `git add -A` away from being permanent in a public history.
/out/
/out-spider/
/out-spider2/

# Local demo scaffolding for the walkthrough: a copied SQLite database, a source manifest
# and an authz policy that both carry absolute paths from one machine. `.demo-env` is not
# covered by the `.env*` rules above (it does not match `.env` or `.env.*`) and it sources
# the real .env, so it is named explicitly rather than left to a near-miss pattern.
/demo-data/
/demo-sources.json
/demo-grants.json
.demo-env

# The workbench bundle. Built by `pnpm build` in workbench/, it lands inside the
# Python package so a wheel picks it up -- the repo carries the source, not the bundle.
src/mnemiq/server/static/
workbench/node_modules/
workbench/dist/

# Python
__pycache__/
*.pyc
.venv/

# Linked git worktrees kept inside the repo. Each is a second checkout of this same
# repository, so leaving it untracked puts it in every `git status` and one careless
# `git add` away from a bogus gitlink.
.worktrees/

# Editor
.vscode/

# OS
.DS_Store

# Credential material. A wallet is the credential: an auto-login `cwallet.sso` needs no password,
# so possessing the file is sufficient to connect. One was found sitting untracked and unignored
# in this root -- never committed, but only a convention stood between it and `git add -A`.
#
# This rule is a BACKSTOP, not the fix. A wallet belongs outside the repo entirely, with
# `TNS_ADMIN` pointed at it: an ignored file still gets archived, grepped, copied into a
# worktree and caught in a screenshot. An ignore rule stops exactly one mistake.
Wallet_*.zip
*wallet*.zip
cwallet.sso
ewallet.p12
ewallet.pem
keystore.jks
truststore.jks
tnsnames.ora
sqlnet.ora
ojdbc.properties

# Tests that write their resolved authz policy to the repo root rather than a tmpdir. The write
# is the defect; this keeps it from becoming a commit while it stands.
/acme_authz.json
/acme_syn_authz.json
/pagila_authz.json

# Generated by scripts/seed_demo.py -- a database, manifest and policy built from code.
/demo/
