{
  "realm": "mnemiq-test",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {"name": "analyst"},
      {"name": "store1_manager"}
    ]
  },
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "email": "ana@example.test",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Test",
      "credentials": [{"type": "password", "value": "ana-test-only", "temporary": false}],
      "realmRoles": ["analyst"]
    },
    {
      "username": "sam",
      "enabled": true,
      "email": "sam@example.test",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Test",
      "credentials": [{"type": "password", "value": "sam-test-only", "temporary": false}],
      "realmRoles": ["store1_manager"]
    }
  ],
  "clients": [
    {
      "clientId": "mnemiq-cli",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "mnemiq-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.custom.audience": "mnemiq-api", "access.token.claim": "true",
                     "id.token.claim": "false"}
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {"claim.name": "tenant", "claim.value": "acme", "jsonType.label": "String",
                     "access.token.claim": "true", "id.token.claim": "false"}
        }
      ]
    },
    {
      "clientId": "mnemiq-openwebui-cli",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "mnemiq-openwebui audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.custom.audience": "mnemiq-openwebui", "access.token.claim": "true",
                     "id.token.claim": "false"}
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {"claim.name": "tenant", "claim.value": "acme", "jsonType.label": "String",
                     "access.token.claim": "true", "id.token.claim": "false"}
        }
      ]
    }
  ]
}
