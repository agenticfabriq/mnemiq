# Copy to .env and fill in. .env is gitignored; never commit real secrets.
MNEMIQ_LLM_BASE_URL=
MNEMIQ_LLM_API_KEY=
MNEMIQ_LLM_MODEL=openai.gpt-5-mini
MNEMIQ_PG_DSN=postgresql://mnemiq:mnemiq@localhost:5432/acme
MNEMIQ_ACME_DATA_DIR=/path/to/ACME_Insurance
# Optional: host port for the docker Postgres (default 5432). Set if 5432 is taken.
# MNEMIQ_PG_PORT=5433

