# mnemiq configuration -- generated by `mnemiq config`. Copy to .env.
# Secrets show empty; fill them in your own .env (never commit real values).

MNEMIQ_LOCAL_ONLY=False  # refuse to start if a chat, embedding, judge or Verity endpoint would leave this machine or network, or a DuckDB extension it loads is not pre-seeded (`mnemiq extensions fetch`; see assert_local_only for exactly what this checks and what it deliberately does not)
MNEMIQ_LLM_BASE_URL=  # chat/generation OpenAI-compat base URL
MNEMIQ_LLM_API_KEY=  # chat/generation API key
MNEMIQ_LLM_MODEL=  # chat/generation model id
MNEMIQ_PG_DSN=  # source Postgres DSN
MNEMIQ_ORACLE_USER=  # source Oracle user (Easy Connect carries no credentials)
MNEMIQ_ORACLE_PASSWORD=  # source Oracle password
MNEMIQ_ORACLE_CONFIG_DIR=  # directory holding tnsnames.ora and, for a TLS target, the wallet; on-prem TNS aliases and Autonomous mTLS both use it
MNEMIQ_ORACLE_WALLET_PASSWORD=  # password for the wallet's ewallet.pem (thin mode cannot use cwallet.sso)
MNEMIQ_ORACLE_POOL_MAX=4  # max pooled Oracle connections; concurrency above this queues for one, bounded by oracle_acquire_timeout_s
MNEMIQ_ORACLE_ACQUIRE_TIMEOUT_S=10.0  # how long a request waits for a pooled Oracle connection before failing; a bounded wait, because the alternative is every worker blocking on one stalled statement
MNEMIQ_ORACLE_PROBE_TIMEOUT_S=30.0  # call timeout for Oracle statements the engine issues about ITSELF -- validation parses and boot advisories -- which have no legitimate reason to run long; 0 disables. Data queries are NOT bounded by this
MNEMIQ_ORACLE_READ_ONLY_TTL_S=300.0  # how long a `constrained` read-only verdict stands before the adapter re-probes the database's open mode; the window is the exposure, since a database reopened READ WRITE reopens M66's PL/SQL write path. 0 disables re-probing
MNEMIQ_ACK_ADVISORIES=  # boot advisories to log at INFO instead of WARNING, comma-separated as <advisory>:<verdict> (e.g. read-only-basis:unverifiable, window:too-small, window:trims); a CHANGED verdict still warns
MNEMIQ_ACME_DATA_DIR=  # ACME golden dataset dir (tests)
MNEMIQ_EMBED_MODEL=  # embedding model id
MNEMIQ_EMBED_BASE_URL=  # embedding endpoint (defaults to chat)
MNEMIQ_EMBED_API_KEY=  # embedding API key (defaults to chat)
MNEMIQ_AUTHZ_PATH=  # local authz grants JSON path
MNEMIQ_SOURCES_PATH=  # multi-source manifest JSON path
MNEMIQ_CONTROL_DSN=  # control Postgres DSN (L2 cache + version pointer)
MNEMIQ_SOURCE_ID=  # single-source id
MNEMIQ_STORE_PATH=  # DuckDB semantic store path
MNEMIQ_MODE=  # default answer mode: instant|thinking|deep
MNEMIQ_WRITE_ENABLED=False  # attach the source read-write (governed writes)
MNEMIQ_CARD_STYLE=cards  # schema card form for the GENERATOR: cards|ddl|bare. `ddl` renders CREATE TABLE for a model fine-tuned on DDL; `bare` is CREATE TABLE with names, types and keys alone; the retrieval index always embeds `cards`.
MNEMIQ_PROFILES_PATH=  # TOML file of named profiles, each a model and its settings per mode, and the roles that may pick it; unset runs these settings as one default profile
MNEMIQ_MODE_SETTINGS=  # per-mode settings as JSON, e.g. {"instant": {"card_style": "bare"}}: card_style, candidates, corrector, judge, min_agreement, budget_s, max_attempts, verify, plan_attempts, prose; unset keeps the mode's own. With MNEMIQ_PROFILES_PATH, state them in the file.
MNEMIQ_WRITER_TEMPERATURE=  # the SQL writer's sampling temperature; unset sends none, so the server's default applies (Qwen2.5: 0.7). Refused for a model that takes none, such as GPT-5, which would ignore it
MNEMIQ_PROMPT_LAYOUT=question_first  # how the writer's prompt is arranged: question_first sends the question and its context as the user message; question_last puts the context in the system message and the question alone in the user message
MNEMIQ_WRITER_REASONING=none  # room for the SQL writer to reason: none asks for the JSON reply alone; before_sql asks it to think the question through step by step first, and reads the last JSON object of its reply. Refused with guided_sql, which allows no text before the JSON
MNEMIQ_WRITER_RULES=full  # the rule text in the SQL writer's system prompt: full carries the persona, the hard rules and the coded-values guidance; none keeps only the task, the decline instruction and the reply format. The decider enforces the hard rules either way
MNEMIQ_GUIDED_SQL=False  # constrained decoding: force non-empty sql (response_format json_schema; works on vLLM and OpenAI-compatible endpoints)
MNEMIQ_ASSERTIVE_SQL=False  # assertive prompt: attempt an answer instead of deferring
MNEMIQ_GUARD_UNDEFINED_TERMS=False  # M35: refuse a declared business term with no certified definition (withdrawn -- see plan_query)
MNEMIQ_GUARD_FANOUT=  # M109: refuse an aggregate over rows a join has multiplied, as a repairable refusal; unset or auto = on when the snapshot's partitions were profiled, 1 = always, 0 = never
MNEMIQ_ANSWER_MARKDOWN=False  # let the answer use markdown (lists, tables) when the result has structure
MNEMIQ_ENRICH_FACTS=False  # eval: table-facts enrichment phase (plan-20, default off)
MNEMIQ_ENRICH_EXAMPLES=False  # eval: verified-example enrichment phase (plan-20, default off)
MNEMIQ_DICTIONARY_PATH=  # operator code data-dictionary JSON path (grounds code meanings)
MNEMIQ_ONTOLOGY_RECORDS_PATH=  # ontology records JSON path (binds code schemes, grounds bare codes)
MNEMIQ_VERITY_RECORDS_URL=  # Verity GET /api/semantic/records/open endpoint (governed certified records). NOT the sibling without `/open`, and DO NOT change the page size to make that one fit: it accepts no `since`, so ANY page size it tolerates -- 0 included -- makes every pull a full dump merged as though it were a delta, silently, while this pull's default 500 makes it refuse outright. Loud is the better failure. Verity's published OpenAPI is where that endpoint's missing `since` and its own limit ceiling are declared
MNEMIQ_VERITY_WATERMARK_PATH=  # path to the Verity /open incremental-sync watermark sidecar JSON (defaults beside the store)
MNEMIQ_VERITY_PAGE_SIZE=500  # Verity /open page size sent as ?limit= (0 = unbounded full dump: no ?limit is sent at all). NOT a way to make the sibling endpoint work -- it accepts no `since` at any page size, so lowering this to its ceiling or to 0 turns a loud 400 into a pull that has silently stopped being incremental
MNEMIQ_VERITY_FULL_RESYNC_AFTER_SECS=86400  # how stale the locally merged certified set may get before it is re-pulled in full; a withdrawal is invisible to an incremental delta, so this window is the only thing that removes one locally (0 = always full)
MNEMIQ_VERITY_TRACES_URL=  # Verity POST /api/traces/batch endpoint; unset = emit nothing (the engine is unchanged)
MNEMIQ_VERITY_TRACE_SEND_TEXT=False  # opt-in: send question text, executed SQL, the answer prose and the deferral MESSAGE (all carry literals from the question and values from the database)
MNEMIQ_VERITY_TRACE_SEND_IDENTITY_DETAIL=False  # opt-in: send email, roles, groups and attributes; none is needed for audit and `attributes` is an open dict a deployment fills
MNEMIQ_VERITY_TRACE_SEND_ROWS=False  # deepest opt-in: send result rows -- the customer's data itself, not a description of it
MNEMIQ_VERITY_TOKEN_URL=  # Keycloak POST .../realms/<realm>/protocol/openid-connect/token endpoint (OAuth2 client-credentials grant)
MNEMIQ_VERITY_CLIENT_ID=  # Verity service client id (created in the workbench API Credentials page)
MNEMIQ_VERITY_CLIENT_SECRET=  # Verity service client secret; presented only to the token endpoint, never to the records endpoint
MNEMIQ_LLM_SEED=  # sampling seed forwarded to the provider on every call; honoured by vLLM, IGNORED by the hosted endpoint (accepted, no system_fingerprint, output still varies) -- so it buys reproducibility on the local path only. Deep mode adds each candidate's index, so its 4th and 5th candidates, which repeat a strategy's prompt, do not repeat its sample
MNEMIQ_LLM_PROMPT_CUT_CHECK=True  # refuse an answer when the server cut the prompt to fit its context window without an error, as Ollama does (M119): a suspicious prompt-token count (far too few for the characters sent, or on a window size) that does not grow when the prompt is re-sent with padding; 0 only for a server or proxy whose prompt_tokens leaves out tokens it reused from a cache
MNEMIQ_LLM_WINDOW_CHECK=True  # at boot, warn when the largest generation prompt this store can produce, plus the generator's reply budget, is longer than the server's context window (M119), for each role the access policy declares and from only what that role is shown: counted by the server where it can (vLLM's /tokenize), else bounded by its bytes against MNEMIQ_LLM_CONTEXT_WINDOW; a warning only, never a refusal
MNEMIQ_LLM_CONTEXT_WINDOW=  # the chat server's context window in tokens, for servers that do not report it (Ollama: your OLLAMA_CONTEXT_LENGTH or num_ctx); vLLM reports its own --max-model-len and this is then ignored
MNEMIQ_MAX_QUESTION_CHARS=4000  # the longest question, in characters, that mnemiq answers; every stage reads it whole, and a longer one is declined before retrieval, so no server is sent it (reason question_too_long), never cut (M147: a 500-character cut in the generator alone answered long questions as cut ones). The boot window check budgets this many tokens for the question, so lower it where the model's window is small
MNEMIQ_RETRIEVAL_K=24  # schema cards retrieved into the generation packet
MNEMIQ_DEFINITION_INDEX_MAX_CONCEPTS=500  # per-scheme concept cap for the enrich-time definition-grounding index
MNEMIQ_BINDING_SUGGESTIONS_PATH=  # where enrich writes ontology binding-suggestions (defaults beside the store)
MNEMIQ_PRINCIPAL=  # MCP standalone identity: principal id
MNEMIQ_ROLES=  # MCP standalone identity: comma-separated roles
MNEMIQ_TENANT=  # MCP standalone identity: tenant id. With a token verifier configured it is required, and every verified token must carry this tenant; `*` accepts any
MNEMIQ_OIDC_ISSUER=  # the identity provider whose tokens the HTTP API and MCP over HTTP verify, matched exactly against `iss`; unset serves the settings identity above
MNEMIQ_OIDC_AUDIENCE=  # the `aud` a token must carry on /v1 and MCP; under MNEMIQ_MCP_TRANSPORT=http it is the MCP door's own URL, https://<host>/mcp
MNEMIQ_OIDC_JWKS_URL=  # where the provider's signing keys are fetched; unset means <issuer>/protocol/openid-connect/certs
MNEMIQ_OIDC_JWKS_FILE=  # a JWKS file read instead of fetching the keys, for a deployment that may not reach the provider
MNEMIQ_OIDC_TENANT_CLAIM=tenant  # the token claim holding the caller's tenant
MNEMIQ_OIDC_ROLES_CLAIM=realm_access.roles  # the dotted path of the token's roles claim; a token without it takes its roles from the identity map
MNEMIQ_OIDC_GROUPS_CLAIM=  # opt-in: pass this claim's groups through as the identity's groups, for a provider whose groups only administrators control; unset, a token's groups grant nothing except through the identity map
MNEMIQ_OIDC_LEEWAY_S=30.0  # clock leeway, in seconds, on a token's exp, nbf and iat
MNEMIQ_OIDC_END_SESSION_URL=  # the identity provider's end-session URL as the browser reaches it, with the sign-in proxy client's `client_id` where the provider needs it: the workbench's Sign out ends there, through the proxy's `rd`, so it ends the provider's session even when the proxy cannot. https, or http only for a loopback address, localhost or a name under .localhost
MNEMIQ_OPENWEBUI_AUDIENCE=  # the `aud` an identity provider's token must carry on Open WebUI's endpoint, distinct from MNEMIQ_OIDC_AUDIENCE; unset, that endpoint accepts no Bearer token
MNEMIQ_OPENWEBUI_JWT_SECRET=  # turns on Open WebUI's signed user header: the HS256 secret it shares with Open WebUI, at least 32 bytes
MNEMIQ_OPENWEBUI_JWT_HEADER=X-OpenWebUI-User-Jwt  # the header carrying Open WebUI's signed user token
MNEMIQ_OPENWEBUI_JWT_MAX_LIFETIME_S=300  # the longest lifetime, exp minus iat, accepted on Open WebUI's signed user token
MNEMIQ_OPENWEBUI_USER_HEADERS=X-OpenWebUI-User-Id,X-OpenWebUI-User-Email,X-OpenWebUI-User-Name,X-OpenWebUI-User-Role  # Open WebUI's unsigned user headers, comma-separated; a request carrying any of them is refused once an issuer is configured
MNEMIQ_OPENWEBUI_CONNECTION_KEY_HEADER=  # the custom header on mnemiq's Open WebUI connection that carries the connection key
MNEMIQ_OPENWEBUI_CONNECTION_KEY=  # the connection key, at least 32 bytes, which tells mnemiq a request came through its own Open WebUI connection; required with the signed user header
MNEMIQ_OPENWEBUI_TASK_HEADER=X-Mnemiq-Task  # the custom header on mnemiq's Open WebUI connection that carries `{{TASK}}`: every /openai/v1 request must carry it, empty for a chat turn, and a request whose value is not empty is a background task, answered with an empty completion and never asked
MNEMIQ_IDENTITY_MAP_PATH=  # a JSON file mapping each issuer's subjects, groups and verified emails to roles, for tokens that carry no roles claim
MNEMIQ_MCP_TRANSPORT=stdio  # stdio runs the MCP server for one local caller; http serves it at /mcp on the HTTP API, each request judged by its own token
MNEMIQ_ANSWER_LOG_PATH=  # where each answer's record goes: which profile, version, model and engine commit produced it, as one JSON line each, with no question text, SQL or rows; unset keeps it beside the store as <store_path>.answers.jsonl, `off` writes none. Not rotated
MNEMIQ_ANSWER_LOG_TEXT=False  # opt-in: the answer log also holds the question and the SQL as asked, which carry literals from the question and values from the database; rows are never logged
MNEMIQ_ENGINE_COMMIT=  # the commit this engine runs, for a build with no git checkout to read it from; stamped on every answer beside the profile's version
MNEMIQ_VERIFY=  # verify override: unset=mode defaults, 0=force off, 1=force full
MNEMIQ_VERIFY_THRESHOLD=0.5  # judge-confidence defer cutoff
MNEMIQ_VERIFY_SANITY=True  # deterministic empty/null layer, in every mode a verifier runs in, on the product and eval paths alike: declines an empty or null result unless every string value it filters on is grounded in the value index (M146); 0 answers every such result, the judge kept where a mode runs one
MNEMIQ_VERIFY_GROUNDING=False  # question-literal grounding layer (opt-in)
MNEMIQ_VERIFY_JUDGE=False  # LLM judge layer (eval path)
MNEMIQ_VERIFY_FAIL_CLOSED=True  # an unreachable judge stops the answer (recorded as a failure, not a deferral) instead of returning it unchecked; 0 restores the fail-open behaviour
MNEMIQ_VERIFY_BASE_URL=  # judge endpoint (defaults to chat)
MNEMIQ_VERIFY_MODEL=  # judge model (defaults to chat)
MNEMIQ_VERIFY_API_KEY=  # judge API key (defaults to chat)

# --- not generated: below this line is hand-written and survives regeneration ---
# repo-guard's proprietary-name blocklist (regex). Lives ONLY here -- never in the
# repo, and deliberately NOT in a CI secret: the check would leak the list by
# enforcing it, since a flagged word in a public Actions log tells every reader that
# word is on the blocklist. `scripts/repo-guard.sh --all` refuses to run it for that
# reason, so a secret of this name would do nothing but sit there readable by anyone
# with write access.
#
# Two valid values. `off` means this machine holds no list and is not meant to --
# copy this file as-is and the pre-commit hook skips the check. A maintainer replaces
# it with the regex. An EMPTY value is neither, and the hook fails closed on it rather
# than guess which you meant.
REPO_GUARD_NAME_PATTERNS=off
