# mnemiq configuration -- generated by `mnemiq config`. Copy to .env.
# Secrets show empty; fill them in your own .env (never commit real values).

MNEMIQ_LLM_BASE_URL=  # chat/generation OpenAI-compat base URL
MNEMIQ_LLM_API_KEY=  # chat/generation API key
MNEMIQ_LLM_MODEL=  # chat/generation model id
MNEMIQ_PG_DSN=  # source Postgres DSN
MNEMIQ_ACME_DATA_DIR=  # ACME golden dataset dir (tests)
MNEMIQ_EMBED_MODEL=  # embedding model id
MNEMIQ_EMBED_BASE_URL=  # embedding endpoint (defaults to chat)
MNEMIQ_EMBED_API_KEY=  # embedding API key (defaults to chat)
MNEMIQ_AUTHZ_PATH=  # local authz grants JSON path
MNEMIQ_SOURCES_PATH=  # multi-source manifest JSON path
MNEMIQ_CONTROL_DSN=  # control Postgres DSN (L2 cache + version pointer)
MNEMIQ_SOURCE_ID=  # single-source id
MNEMIQ_STORE_PATH=  # DuckDB semantic store path
MNEMIQ_MODE=  # default answer mode: instant|thinking|deep
MNEMIQ_WRITE_ENABLED=False  # attach the source read-write (governed writes)
MNEMIQ_GUIDED_SQL=False  # constrained decoding: force non-empty sql (response_format json_schema; works on vLLM and OpenAI-compatible endpoints)
MNEMIQ_ASSERTIVE_SQL=False  # assertive prompt: attempt an answer instead of deferring
MNEMIQ_ANSWER_MARKDOWN=False  # let the answer use markdown (lists, tables) when the result has structure
MNEMIQ_ENRICH_FACTS=False  # eval: table-facts enrichment phase (plan-20, default off)
MNEMIQ_ENRICH_EXAMPLES=False  # eval: verified-example enrichment phase (plan-20, default off)
MNEMIQ_DICTIONARY_PATH=  # operator code data-dictionary JSON path (grounds code meanings)
MNEMIQ_ONTOLOGY_RECORDS_PATH=  # ontology records JSON path (binds code schemes, grounds bare codes)
MNEMIQ_VERITY_RECORDS_URL=  # Verity GET /api/semantic/records endpoint (governed certified records)
MNEMIQ_VERITY_WATERMARK_PATH=  # path to the Verity /open incremental-sync watermark sidecar JSON (defaults beside the store)
MNEMIQ_VERITY_PAGE_SIZE=500  # Verity /open page size sent as ?limit= (0 = unbounded full dump)
MNEMIQ_VERITY_FULL_RESYNC_AFTER_SECS=86400  # how stale the locally merged certified set may get before it is re-pulled in full; a withdrawal is invisible to an incremental delta, so this window is the only thing that removes one locally (0 = always full)
MNEMIQ_VERITY_TRACES_URL=  # Verity POST /api/traces/batch endpoint; unset = emit nothing (the engine is unchanged)
MNEMIQ_VERITY_TRACE_SEND_TEXT=False  # opt-in: send question text, executed SQL, the answer prose and the deferral MESSAGE (all carry literals from the question and values from the database)
MNEMIQ_VERITY_TRACE_SEND_IDENTITY_DETAIL=False  # opt-in: send email, roles, groups and attributes; none is needed for audit and `attributes` is an open dict a deployment fills
MNEMIQ_VERITY_TRACE_SEND_ROWS=False  # deepest opt-in: send result rows -- the customer's data itself, not a description of it
MNEMIQ_VERITY_TOKEN_URL=  # Keycloak POST .../realms/<realm>/protocol/openid-connect/token endpoint (OAuth2 client-credentials grant)
MNEMIQ_VERITY_CLIENT_ID=  # Verity service client id (created in the workbench API Credentials page)
MNEMIQ_VERITY_CLIENT_SECRET=  # Verity service client secret; presented only to the token endpoint, never to the records endpoint
MNEMIQ_LLM_SEED=  # sampling seed forwarded to the provider; honoured by vLLM, IGNORED by the hosted endpoint (accepted, no system_fingerprint, output still varies) -- so it buys reproducibility on the local path only
MNEMIQ_RETRIEVAL_K=24  # schema cards retrieved into the generation packet
MNEMIQ_DEFINITION_INDEX_MAX_CONCEPTS=500  # per-scheme concept cap for the enrich-time definition-grounding index
MNEMIQ_BINDING_SUGGESTIONS_PATH=  # where enrich writes ontology binding-suggestions (defaults beside the store)
MNEMIQ_PRINCIPAL=  # MCP standalone identity: principal id
MNEMIQ_ROLES=  # MCP standalone identity: comma-separated roles
MNEMIQ_TENANT=  # MCP standalone identity: tenant id
MNEMIQ_VERIFY=  # verify override: unset=mode defaults, 0=force off, 1=force full
MNEMIQ_VERIFY_THRESHOLD=0.5  # judge-confidence defer cutoff
MNEMIQ_VERIFY_SANITY=True  # deterministic empty/null defer layer
MNEMIQ_VERIFY_GROUNDING=False  # question-literal grounding layer (opt-in)
MNEMIQ_VERIFY_JUDGE=False  # LLM judge layer (eval path)
MNEMIQ_VERIFY_BASE_URL=  # judge endpoint (defaults to chat)
MNEMIQ_VERIFY_MODEL=  # judge model (defaults to chat)
MNEMIQ_VERIFY_API_KEY=  # judge API key (defaults to chat)

# --- not generated: below this line is hand-written and survives regeneration ---
# repo-guard's proprietary-name blocklist (regex). Lives only here and in the
# CI secret of the same name -- never in the repo. scripts/repo-guard.sh reads
# it from .env when the environment does not set it, so losing this line
# silently disarms the guard that keeps proprietary names out of a public repo.
REPO_GUARD_NAME_PATTERNS=
