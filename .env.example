# mnemiq configuration -- generated by `mnemiq config`. Copy to .env.
# Secrets show empty; fill them in your own .env (never commit real values).

MNEMIQ_LLM_BASE_URL=  # chat/generation OpenAI-compat base URL
MNEMIQ_LLM_API_KEY=  # chat/generation API key
MNEMIQ_LLM_MODEL=  # chat/generation model id
MNEMIQ_PG_DSN=  # source Postgres DSN
MNEMIQ_ACME_DATA_DIR=  # ACME golden dataset dir (tests)
MNEMIQ_EMBED_MODEL=  # embedding model id
MNEMIQ_EMBED_BASE_URL=  # embedding endpoint (defaults to chat)
MNEMIQ_EMBED_API_KEY=  # embedding API key (defaults to chat)
MNEMIQ_AUTHZ_PATH=  # local authz grants JSON path
MNEMIQ_SOURCES_PATH=  # multi-source manifest JSON path
MNEMIQ_CONTROL_DSN=  # control Postgres DSN (L2 cache + version pointer)
MNEMIQ_SOURCE_ID=  # single-source id
MNEMIQ_STORE_PATH=  # DuckDB semantic store path
MNEMIQ_MODE=  # default answer mode: instant|thinking|deep
MNEMIQ_WRITE_ENABLED=False  # attach the source read-write (governed writes)
MNEMIQ_GUIDED_SQL=False  # constrained decoding: force non-empty sql (vLLM guided_json)
MNEMIQ_ASSERTIVE_SQL=False  # assertive prompt: attempt an answer instead of deferring
MNEMIQ_RETRIEVAL_K=12  # schema cards retrieved into the generation packet
MNEMIQ_PRINCIPAL=  # MCP standalone identity: principal id
MNEMIQ_ROLES=  # MCP standalone identity: comma-separated roles
MNEMIQ_TENANT=  # MCP standalone identity: tenant id
MNEMIQ_VERIFY=  # verify override: unset=mode defaults, 0=force off, 1=force full
MNEMIQ_VERIFY_THRESHOLD=0.5  # judge-confidence defer cutoff
MNEMIQ_VERIFY_SANITY=True  # deterministic empty/null defer layer
MNEMIQ_VERIFY_GROUNDING=False  # question-literal grounding layer (opt-in)
MNEMIQ_VERIFY_JUDGE=False  # LLM judge layer (eval path)
MNEMIQ_VERIFY_BASE_URL=  # judge endpoint (defaults to chat)
MNEMIQ_VERIFY_MODEL=  # judge model (defaults to chat)
MNEMIQ_VERIFY_API_KEY=  # judge API key (defaults to chat)
