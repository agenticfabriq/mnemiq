#!/usr/bin/env bash
# Enable with: git config core.hooksPath .githooks
#
# Two gates, cheapest first. Both must pass; neither is allowed to be the only one.
#
# Lint is here because it was NOT, and five ruff errors reached `main` and kept CI red for two
# days (PR #7). The hook ran repo-guard and `exec`'d away, so a commit could be blessed locally
# and fail the very first thing CI does. A gate that checks less than CI teaches people its
# green means something it does not.
set -uo pipefail

top="$(git rev-parse --show-toplevel)" || exit 1
cd "$top" || exit 1

"./scripts/repo-guard.sh" --staged || exit $?

if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: BLOCKED [config]: uv is not on PATH, so lint could not run."
  echo "Install uv (https://docs.astral.sh/uv/), or commit with --no-verify if you accept CI"
  echo "finding what this would have. Failing closed, the same way repo-guard does: a gate that"
  echo "waves a commit through when it could not check it is worse than no gate."
  exit 1
fi

# Lint the INDEX, not the working tree. `ruff check .` would read the files on disk, which are
# not what is being committed: stage a violation and fix it without `git add`, or stage a subset
# with `git add -p`, and a working-tree lint passes while CI fails on the content that landed.
# This repo stages explicitly and partially by convention, so that is the common case, not the
# exotic one -- and it is the same "green locally, red in CI" shape the gate exists to close.
#
# `checkout-index` materialises exactly the committed tree, config files included, so ruff
# resolves the same settings CI will. Measured at 445 files: ~0.2s to copy, ~0.3s to lint.
staged="$(mktemp -d)" || { echo "pre-commit: BLOCKED [config]: could not create a temp dir."; exit 1; }
trap 'rm -rf "$staged"' EXIT
# `--ignore-skip-worktree-bits` because checkout-index silently SKIPS those entries otherwise,
# so under a sparse checkout the gate would lint the cone and wave the rest through.
if ! git checkout-index --all --ignore-skip-worktree-bits --prefix="$staged/"; then
  echo "pre-commit: BLOCKED [config]: could not materialise the index for linting."
  exit 1
fi

# "Nothing was wrong" and "nothing was linted" are the same exit code from ruff: 0, with a
# `No Python files found` warning the rc=0 branch would discard. So ask ruff what it is about to
# check, and refuse if the answer is nothing.
#
# Deliberately NOT a count comparison against the index. I tried that and it was wrong three
# ways: `[tool.ruff]` excludes mean the file count and the LINTED count are different numbers,
# a tracked symlink or a case-folded pair makes them differ forever, and a second command whose
# failure leaves the variable empty fails the check open under `set -u` without `-e`. Detecting
# a PARTIAL materialisation by counting is not worth that; it is prevented at the source, by
# `--all --ignore-skip-worktree-bits` and a checked exit code. This catches the collapse that
# actually reads as success.
show_out="$(uv run --frozen --extra dev -- ruff check --show-files "$staged" 2>&1)"
show_rc=$?
if [ "$show_rc" -ne 0 ]; then
  # Keep the diagnostic. Swallowing stderr here would leave stdout empty and send the operator
  # to hunt a materialisation problem when the real fault is an environment that cannot run
  # ruff at all -- the crying-wolf failure this file objects to two branches down.
  printf '%s\n' "${show_out//$staged\//}"
  echo
  echo "pre-commit: BLOCKED [config]: could not determine what ruff would check (exit $show_rc)."
  echo "NOT a lint failure -- usually an unresolvable environment; try 'uv sync --extra dev'."
  exit 1
fi
# Only Python files count. `--show-files` also lists `pyproject.toml`, so a bare line count is
# >=1 whenever the config was materialised, even with zero Python files next to it -- which
# would have made this guard weaker than the one it replaced (verified: a directory holding
# only this repo's pyproject.toml prints one line and lints clean).
linted="$(printf '%s\n' "$show_out" | grep -cE '\.pyi?$')"
if [ "${linted:-0}" -eq 0 ]; then
  echo "pre-commit: BLOCKED [config]: ruff found no Python files to check in the materialised"
  echo "index, so it would have reported success having linted nothing. That is not a pass."
  exit 1
fi

# `--extra dev` is load-bearing: ruff is declared ONLY in that extra, so without it `uv run`
# neither installs nor version-checks ruff -- it leaves whatever is in .venv alone and, if
# nothing is there, silently falls back to any `ruff` on PATH. A plain `uv sync` prunes ruff
# (verified: it appears in the 11 packages that sync would uninstall), so the fallback is not
# hypothetical. With the extra, this is the exact version the lockfile pins, which is the whole
# point of running lint here rather than trusting the developer's environment.
# The CONFIG ruff applies comes from the staged tree -- verified with `--show-settings`, whose
# `project_root` is the temp copy. The BINARY does not: `uv run` executes here, at the working
# tree root, so it resolves ruff from THIS uv.lock. Two ways that diverges from CI, and both are
# checked, because the whole point of this gate is that what it checks is what lands.
#
# 1. The staged lock disagreeing with the staged pyproject. CI runs `uv sync` WITHOUT --frozen,
#    so it re-resolves a stale lock and lints with whatever it gets. Asking uv is exact and
#    costs ~70ms; comparing a version range by hand would not be.
lockcheck="$(uv lock --check --project "$staged" 2>&1)"
lock_rc=$?   # named, like every other exit capture here: a line inserted above a bare `$?`
if [ "$lock_rc" -ne 0 ]; then
  printf '%s\n' "${lockcheck//$staged\//}"
  echo
  # uv's own message is printed above and is left to speak for itself. Two attempts at
  # classifying its exit codes here were wrong in opposite directions -- 1 turned out to cover
  # both "stale" and "no valid resolution", and 2 covers both "unreadable" and "missing", where
  # re-locking IS the fix. Each wrong guess sent the operator at a command that could not work,
  # which is the exact failure a helpful-sounding message is supposed to prevent. uv already
  # names the cause and the remedy in every one of those cases; paraphrasing it added nothing
  # but a second, less accurate voice.
  echo "pre-commit: BLOCKED [config]: the staged project does not resolve cleanly, so CI --"
  echo "which syncs WITHOUT --frozen -- could install a different toolchain than this gate"
  echo "just linted with. uv's diagnosis is above; whatever it fixes, stage the result."
  exit 1
fi

# 2. The staged lock disagreeing with the working tree's, which is the one `uv run` above will
#    actually use.
#
#    Compared on ruff's IDENTITY, not on its version. Two locks can both say 0.15.21 and mean
#    different artifacts -- uv records where each one is fetched from and a sha256 for it, so a
#    staged lock can keep the version string and point somewhere else entirely. On a public repo
#    taking outside contributions that is a supply-chain shape, not a nit. The version is still
#    parsed out afterwards, but only to say WHICH kind of mismatch it is.
ruff_entry() {  # ruff's IDENTITY from $1: version, registry, artifact urls, sha256 hashes
  # The identity fields only, not the raw block. Byte-comparing the block flags differences that
  # are not differences: uv writes `upload-time` and `size` alongside each artifact, and a
  # contributor on an older uv produces an entry with identical registry and identical sha256s
  # that still differs textually. Accusing them of swapping a binary because their serializer
  # is older is the crying-wolf failure this file objects to further down -- and it would land
  # on outside contributors first, who are exactly the case this guard exists for.
  #
  # What "the same ruff" means: the version, the registry, and every artifact as a URL PAIRED
  # WITH its hash. The pairing is the point -- pulling the fields out separately and sorting
  # them yields a token soup in which two wheels' hashes can be transposed with no change to
  # the multiset (measured: that edit passed). So url and hash are extracted as ONE token.
  #
  # An ALLOWLIST, deliberately. Keeping whole lines and stripping the volatile fields is the
  # obvious alternative and it is backwards: it tolerates only the fields someone remembered to
  # name, so the first time uv adds a field, every contributor whose lock has it is told their
  # binary was swapped. That field set moves -- this repo's first uv.lock had no `upload-time`
  # at all and today's has one per artifact. Naming what identity IS survives the serializer
  # changing around it; naming what to ignore does not.
  awk 'BEGIN{RS="";FS="\n"} /(^|\n)name = "ruff"($|\n)/{print; exit}' "$1" 2>/dev/null \
    | grep -oE 'version = "[^"]+"|registry = "[^"]+"|url = "[^"]+", hash = "sha256:[0-9a-f]{64}"' \
    | sort
}
want_entry="$(ruff_entry "$staged/uv.lock")"
have_entry="$(ruff_entry uv.lock)"

# Fails CLOSED when either side cannot be read, because a guard that could not run must not read
# as a guard that passed -- the collapse this file exists to refuse. Note this does not make the
# extraction itself safe: a lockfile format change could return the wrong block rather than
# nothing, and that would block loudly on a bogus mismatch. Loud and wrong beats silent and
# wrong, and is not the same as correct.
if [ -z "$want_entry" ] || [ -z "$have_entry" ]; then
  # `${v:+ok}${v:-unreadable}` looked like a status but is not one: `:-` substitutes the VALUE
  # when the variable is non-empty, so the readable side printed "ok" followed by the whole
  # 24-line entry.
  [ -n "$want_entry" ] && ws="ok" || ws="unreadable"
  [ -n "$have_entry" ] && hs="ok" || hs="unreadable"
  echo "pre-commit: BLOCKED [config]: could not read ruff's identity from both lockfiles"
  echo "(staged: $ws, working tree: $hs), so the check that this commit's tool is the tool CI"
  echo "installs could not be made. Not a lint failure."
  exit 1
fi

lock_version() { printf '%s\n' "$1" | awk -F'"' '/^version = /{print $2; exit}'; }
want_ruff="$(lock_version "$want_entry")"
have_ruff="$(lock_version "$have_entry")"

if [ "$want_entry" != "$have_entry" ]; then
  if [ "$want_ruff" != "$have_ruff" ]; then
    echo "pre-commit: BLOCKED [config]: this commit stages ruff $want_ruff, but the ruff resolved"
    echo "here is $have_ruff -- taken from the WORKING TREE's lockfile, which is not what CI will"
    echo "install."
  else
    echo "pre-commit: BLOCKED [config]: both lockfiles say ruff $want_ruff, but they resolve it"
    echo "to a DIFFERENT artifact. Diff the ruff entries in the two lockfiles on the registry,"
    echo "and on each url TOGETHER WITH its hash -- the mismatch can be in the pairing alone,"
    echo "with every url and every hash present on both sides, so checking the two lists"
    echo "separately will show you nothing."
  fi
  echo "'git add' uv.lock and pyproject.toml together so the tool that checks this commit is the"
  echo "tool that checks it in CI."
  exit 1
fi

# And the binary that ran reports the VERSION its lock entry pins. Deliberately a weaker claim
# than the comparison above: this cannot tell one 0.15.21 build from another, so a substituted
# binary of the right version passes here. It catches the environment simply not being the one
# the lock describes, which is the failure that actually happens.
ran_ruff="$(uv run --frozen --extra dev -- ruff --version | awk '{print $2}')"
if [ -z "$ran_ruff" ] || [ "$ran_ruff" != "$have_ruff" ]; then
  echo "pre-commit: BLOCKED [config]: the ruff that ran reports '${ran_ruff:-nothing}', but the"
  echo "lockfile pins $have_ruff. The environment is not the one the lock describes; try"
  echo "'uv sync --extra dev'. Not a lint failure."
  exit 1
fi

output="$(uv run --frozen --extra dev -- ruff check "$staged" 2>&1)"
rc=$?
output="${output//$staged\//}"   # report repo-relative paths, not the temp copy's

case "$rc" in
  0) echo "pre-commit: clean (repo-guard, ruff)." ;;
  # ruff exits 1 for violations and 2 for its own errors; anything else came from uv. Only the
  # first is a lint failure, and sending someone to hunt for a diagnostic that was never printed
  # is how a gate earns a reputation for crying wolf.
  1) echo "$output"
     echo
     echo "pre-commit: BLOCKED [lint]: the STAGED content fails ruff, which is the first thing"
     echo "CI runs. Those paths are repo-relative but describe what is staged, NOT what is on"
     echo "disk -- if you have already fixed it in your working tree, the fix is 'git add', and"
     echo "running ruff yourself will confusingly say everything passes. Otherwise:"
     echo "  uv run --extra dev ruff check --fix .   (then stage the result)"
     exit 1 ;;
  *) echo "$output"
     echo
     echo "pre-commit: BLOCKED [config]: lint could not run (exit $rc) -- this is NOT a lint"
     echo "failure. Usually a missing or unresolvable environment; 'uv sync --extra dev' first."
     exit 1 ;;
esac
